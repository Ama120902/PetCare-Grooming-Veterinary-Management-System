	<query language="sql"><![CDATA[SELECT
    a.appointment_id AS appointment_id,
    a.appointment_datetime AS appointment_datetime,
    c.customer_name AS customer_name,
    p.pet_name AS pet_name,
    s.service_name AS service_name,
    a.status AS status
FROM appointments a
JOIN customers c ON a.customer_id = c.customer_id
JOIN pets p ON a.pet_id = p.pet_id
JOIN services s ON a.service_id = s.service_id
ORDER BY a.appointment_datetime DESC]]></query>
	<field name="appointment_id" class="java.lang.String"/>
	<field name="appointment_datetime" class="java.lang.String"/>
